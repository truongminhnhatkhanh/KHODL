                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="C5">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(IsNothing(Fields!Avg_LOS_Inpatient.Value), 0, Fields!Avg_LOS_Inpatient.Value)</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><Border><Style>Solid</Style></Border><PaddingRight>4pt</PaddingRight></Style>
