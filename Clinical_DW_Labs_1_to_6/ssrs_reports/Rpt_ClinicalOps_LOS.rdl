<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSets>
    <DataSet Name="DS_ClinicalOps">
      <SharedDataSet>
        <SharedDataSetReference>DS_ClinicalOps</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="Service_Type">
          <DataField>Service_Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Department_Name">
          <DataField>Department_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total_Visits">
          <DataField>Total_Visits</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Total_Inpatient_Days">
          <DataField>Total_Inpatient_Days</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Avg_LOS_Inpatient">
          <DataField>Avg_LOS_Inpatient</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TitleBox">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>BÁO CÁO 2: VẬN HÀNH LÂM SÀNG, THỜI GIAN NẰM VIỆN (LOS) &amp; CƠ CẤU DỊCH VỤ</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>0.15in</Top>
            <Left>0.2in</Left>
            <Height>0.38in</Height>
            <Width>9.6in</Width>
          </Textbox>
          <Chart Name="ChartLOS">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="ChartLOS_Dept">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Department_Name.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <Label>=Fields!Department_Name.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Label>Tổng ngày nằm viện (LOS)</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="SeriesInpatientDays">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!Total_Inpatient_Days.Value)</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style />
                        <Visible>true</Visible>
                      </ChartDataLabel>
                    </ChartDataPoint>
                  </ChartDataPoints>
                  <Type>Bar</Type>
                  <Style>
                    <Color>#0284C7</Color>
                  </Style>
                  <ChartItemInLegend>
                    <LegendText>Tổng ngày nằm viện</LegendText>
                  </ChartItemInLegend>
                </ChartSeries>
              </ChartSeriesCollection>
            </ChartData>
            <ChartAreas>
              <ChartArea Name="Default">
                <ChartCategoryAxes>
                  <ChartAxis Name="Primary">
                    <Style>
                      <FontSize>9pt</FontSize>
                    </Style>
                    <ChartAxisTitle>
                      <Caption>Chuyên khoa</Caption>
                      <Style>
                        <FontSize>9pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </ChartAxisTitle>
                  </ChartAxis>
                </ChartCategoryAxes>
                <ChartValueAxes>
                  <ChartAxis Name="Primary">
                    <Style>
                      <FontSize>9pt</FontSize>
                    </Style>
                    <ChartAxisTitle>
                      <Caption>Tổng ngày điều trị nội trú (ngày)</Caption>
                      <Style>
                        <FontSize>9pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </ChartAxisTitle>
                  </ChartAxis>
                </ChartValueAxes>
              </ChartArea>
            </ChartAreas>
            <ChartLegends>
              <ChartLegend Name="Default">
                <Position>BottomCenter</Position>
              </ChartLegend>
            </ChartLegends>
            <ChartTitles>
              <ChartTitle Name="Default">
                <Caption>Tổng ngày nằm viện theo Chuyên khoa</Caption>
                <Style>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </ChartTitle>
            </ChartTitles>
            <Palette>BrightPastel</Palette>
            <DataSetName>DS_ClinicalOps</DataSetName>
            <Top>0.65in</Top>
            <Left>0.2in</Left>
            <Height>3.2in</Height>
