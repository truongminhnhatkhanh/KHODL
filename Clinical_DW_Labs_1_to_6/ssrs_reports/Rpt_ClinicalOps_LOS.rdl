                      <CellContents>
                        <Textbox Name="C1">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Service_Type.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><Border><Style>Solid</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="C2">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Department_Name.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><Border><Style>Solid</Style></Border><PaddingLeft>4pt</PaddingLeft></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="C3">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Total_Visits.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs>
