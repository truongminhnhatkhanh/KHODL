Table Dim_Patient {
  Patient_Key int [pk, increment]
  Anonymized_Patient_ID varchar(64) [unique]
  Age_Group varchar(20)
  Gender varchar(10)
  Location varchar(255)
  Insurance_Tier varchar(100)
}

Table Dim_Doctor {
  Doctor_Key int [pk, increment]
  Doctor_ID varchar(20)
  Doctor_Name varchar(100)
  Specialty varchar(100)
  Hospital_Branch varchar(100)
  Years_Experience int
  Effective_Date date
  End_Date date
  Is_Current boolean
}

Table Dim_Department {
  Department_Key int [pk, increment]
  Department_Name varchar(100)
  Clinic_Room varchar(50)
  Division varchar(50)
}

Table Dim_Date {
  Date_Key int [pk]
  Full_Date date
  Day_Of_Week varchar(15)
  Month int
  Quarter int
  Year int
  Year_Month varchar(7)
  Shift varchar(20)
  Is_Weekend boolean
}

Table Dim_Diagnosis {
  Diagnosis_Key int [pk, increment]
  ICD10_Code varchar(20)
  Treatment_Type varchar(100)
  Disease_Category varchar(100)
  Chronic_Indicator boolean
}

Table Dim_Service {
  Service_Key int [pk, increment]
  Service_Code varchar(20)
  Service_Name varchar(100)
  Service_Type varchar(50)
  Note: 'Outpatient / Inpatient / Surgery / Emergency'
}

Table Fact_Patient_Visits {
  Visit_Key int [pk, increment]
  Appointment_ID varchar(20) [unique]
  Patient_Key int [ref: > Dim_Patient.Patient_Key]
  Doctor_Key int [ref: > Dim_Doctor.Doctor_Key]
  Department_Key int [ref: > Dim_Department.Department_Key]
  Date_Key int [ref: > Dim_Date.Date_Key]
  Diagnosis_Key int [ref: > Dim_Diagnosis.Diagnosis_Key]
  Service_Key int [ref: > Dim_Service.Service_Key]
  Waiting_Time_Minutes int
  Consultation_Duration int
  Length_Of_Stay_Days int
  Total_Cost decimal(12,2)
  Insurance_Covered_Amount decimal(12,2)
  Patient_Paid_Amount decimal(12,2)
}
