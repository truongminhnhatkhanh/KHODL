// ====================================================================
// 📊 BỘ CÔNG THỨC DAX — 3 TRANG DASHBOARD POWER BI (V2)
// Clinical Data Warehouse - VKU (Lớp 24GITe)
// ★ Thêm: Dim_Service measures, Insurance phân hóa, Service breakdown
// ====================================================================

// --- 🌟 TRANG 1: WAIT-TIME HEATMAP (BẢN ĐỒ NHIỆT THỜI GIAN CHỜ) ---
// Visual: Matrix (Rows: Department_Name, Columns: Day_Of_Week hoặc Shift)
// Conditional Formatting: Background Color Xanh lục → Vàng → Đỏ

Avg Wait Time = AVERAGE('Fact_Patient_Visits'[Waiting_Time_Minutes])

Max Wait Time = MAX('Fact_Patient_Visits'[Waiting_Time_Minutes])

Total Visits = COUNTROWS('Fact_Patient_Visits')

Avg Consultation Duration = AVERAGE('Fact_Patient_Visits'[Consultation_Duration])

Wait Time vs Target =
VAR Target = 30
RETURN [Avg Wait Time] - Target


// --- 🌟 TRANG 2: BED OCCUPANCY & SERVICE MIX ---
// Visual 1: Line + Clustered Column (X: Year_Month, Column: Inpatient Days, Line: Occupancy %)
// Visual 2: Donut Chart (Service_Type breakdown)
// Visual 3: KPI Cards (Inpatient Ratio, Surgery Cases, Emergency Cases)

Total Inpatient Days = SUM('Fact_Patient_Visits'[Length_Of_Stay_Days])

Avg Length of Stay (Days) =
CALCULATE(
    AVERAGE('Fact_Patient_Visits'[Length_Of_Stay_Days]),
    'Fact_Patient_Visits'[Length_Of_Stay_Days] > 0
)

Bed Occupancy Rate % =
VAR TotalAvailableBeds = 50
VAR DaysInPeriod = DISTINCTCOUNT('Dim_Date'[Full_Date])
RETURN DIVIDE([Total Inpatient Days], TotalAvailableBeds * DaysInPeriod, 0)

// ★ MỚI: Phân tích theo Loại dịch vụ (Dim_Service)
Outpatient Visits =
CALCULATE(
    COUNTROWS('Fact_Patient_Visits'),
    'Dim_Service'[Service_Type] = "Outpatient"
)

Inpatient Visits =
CALCULATE(
    COUNTROWS('Fact_Patient_Visits'),
    'Dim_Service'[Service_Type] = "Inpatient"
)

Surgery Cases =
CALCULATE(
    COUNTROWS('Fact_Patient_Visits'),
    'Dim_Service'[Service_Type] = "Surgery"
)

Emergency Cases =
CALCULATE(
    COUNTROWS('Fact_Patient_Visits'),
    'Dim_Service'[Service_Type] = "Emergency"
)

Inpatient Ratio % = DIVIDE([Inpatient Visits], [Total Visits], 0)

Outpatient Ratio % = DIVIDE([Outpatient Visits], [Total Visits], 0)


// --- 🌟 TRANG 3: REVENUE & INSURANCE BREAKDOWN ---
// Visual 1: Stacked Bar (Y: Disease_Category, X: Insurance Covered + Patient Paid)
// Visual 2: Donut (Legend: Insurance_Tier, Values: Total Revenue)
// Visual 3: Clustered Bar (Y: Service_Type, X: Total Revenue)
// Visual 4: KPI Card (Insurance Coverage Ratio %)

Total Revenue = SUM('Fact_Patient_Visits'[Total_Cost])

Total Insurance Covered = SUM('Fact_Patient_Visits'[Insurance_Covered_Amount])

Total Patient Paid = SUM('Fact_Patient_Visits'[Patient_Paid_Amount])

Insurance Coverage Ratio % = DIVIDE([Total Insurance Covered], [Total Revenue], 0)

Patient Out Of Pocket Ratio % = DIVIDE([Total Patient Paid], [Total Revenue], 0)

Avg Revenue Per Visit = DIVIDE([Total Revenue], [Total Visits], 0)

Avg Revenue Per Patient =
AVERAGEX(
    VALUES('Fact_Patient_Visits'[Patient_Key]),
    [Total Revenue]
)

Avg Monthly Revenue =
AVERAGEX(
    VALUES('Dim_Date'[Year_Month]),
    [Total Revenue]
)

// ★ MỚI: Revenue theo Service Type
Revenue Inpatient =
CALCULATE([Total Revenue], 'Dim_Service'[Service_Type] = "Inpatient")

Revenue Outpatient =
CALCULATE([Total Revenue], 'Dim_Service'[Service_Type] = "Outpatient")

Revenue Surgery =
CALCULATE([Total Revenue], 'Dim_Service'[Service_Type] = "Surgery")

Revenue Emergency =
CALCULATE([Total Revenue], 'Dim_Service'[Service_Type] = "Emergency")
